;; The hub is granted web-demo and may read it through agentloop's
;; quarantined reader. It asks the reader whether the office opens on
;; Tuesday 13 October, with a schema that admits no free text. The page
;; holds a hidden injection, which the reader sees and the hub never
;; does. The answer is a boolean, so the hub's session stays clean, and
;; the fact it records from the answer carries no contaminated label.
{:doc "A closed answer from the quarantined reader leaves the session and its writes clean."
 :live? false
 :settings {:grants {"hub" {:tools ["web-demo"] :quarantine ["web-demo"]}}}

 :model
 {"hub" [{:tool-uses [{:name "read_quarantined"
                       :input {:tool "web-demo" :input {:page "office-page.html"}
                               :question "Is the office open on Tuesday 13 October?"
                               :schema {:type "object"
                                        :properties {:open {:type "boolean"}}
                                        :required ["open"]
                                        :additionalProperties false}}}]}
         {:tool-uses [{:name "fact_add"
                       :input {:text "The staging office is open on Tuesday 13 October." :topic "office"}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Office hours"}} :outcome "Recorded that it opens."}}]}
         {:text "Done."}]}

 :reader [{:text "{\"answer\": {\"open\": true}}"}]

 :steps
 [{:run ["memo" "hub" "-s" "Office hours" "-m" "Check office-page.html: is the office open on Tuesday 13 October?"]}
  {:tick 1}]

 :assert
 [[:has :tool-call {:role "hub" :name "read_quarantined" :verdict "allow"
                    :result [:all [:includes "\"answer\":{\"open\":true}"] [:includes "\"free_text\":false"]]}]
  [:none :tool-call {:result [:includes "AI assistants"]}]
  [:has :wake {:role "hub" :outcome "ran" :labels ["private"]}]
  [:none :wake {:role "hub" :labels [:contains "contaminated"]}]
  [:has :fact {:text "The staging office is open on Tuesday 13 October."
               :labels ["private"]}]
  [:has :memo {:subject "Office hours" :status :read :closed-by "hub"}]
  [:none :hold {}]]}
