;; The hub, its session holding the operator's private data, asks the
;; public scout for something. The memo waits, unseen, until the operator
;; declassifies it on the terminal; then the scout is woken and does it.
{:doc "A memo to a public role from a private session waits for relay declassify."
 :live? false

 :model
 {"hub" [{:tool-uses [{:name "memo_send"
                       :input {:to "scout" :subject "Find arts grants"
                               :body "Find open arts grants for this spring."}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Ask the scout"}} :outcome "Asked the scout."}}]}
         {:text "Done."}]
  "scout" [{:tool-uses [{:name "memo_close"
                         :input {:memo {:memo-id {:subject "Find arts grants"}} :outcome "Found two."}}]}
           {:text "Done."}]}

 :steps
 [{:run ["memo" "hub" "-s" "Ask the scout" "-m" "Ask the scout to find open arts grants."]}
  {:tick 2}
  {:assert [[:has :memo {:from "hub" :to "scout" :subject "Find arts grants" :status :unread}]
            [:has :notification {:kind "memo-awaiting-declassification"}]
            [:none :wake {:role "scout"}]]}
  {:run ["declassify" {:memo-id {:subject "Find arts grants"}}]}
  {:tick 2}]

 :assert
 [[:has :event {:type "memo/declassified"}]
  [:has :wake {:role "scout" :outcome "ran"}]
  [:has :memo {:subject "Find arts grants" :status :read :closed-by "scout"}]
  [:none :hold {:role "scout"}]]}
