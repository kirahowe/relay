;; The simplest path: the operator sends the steward a memo, a tick wakes the
;; steward, and the steward closes it. Also runs against the real model.
{:doc "An operator memo to the steward is woken on, read and closed."
 :live? true

 :model
 {"steward" [{:text "Let me look." :tool-uses [{:name "inbox" :input {}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Where is the office?"}}
                               :outcome "The staging office is closed on Mondays."}}]}
         {:text "Closed it."}]}

 :steps
 [{:run ["memo" "steward" "-s" "Where is the office?"
         "-m" "Close this memo, saying in one sentence that the staging office is closed on Mondays."]}
  {:tick 2}]

 :assert
 [[:has :memo {:from "operator" :to "steward" :subject "Where is the office?" :status :read :closed-by "steward"}]
  [:has :wake {:role "steward" :outcome "ran"}]
  [:none :memo {:status :unread}]
  [:none :dead-letter {}]]}
