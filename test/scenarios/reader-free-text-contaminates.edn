;; As reader-closed-answer-stays-clean, but the hub asks for the hours as
;; free text. The reader could have copied the page's injection into a
;; string, so agentloop keeps contaminated on the answer: the hub's
;; session is contaminated, and so is the fact it records.
{:doc "A free-text answer from the quarantined reader contaminates the session."
 :live? false
 :settings {:grants {"hub" {:tools ["web-demo"] :quarantine ["web-demo"]}}}

 :model
 {"hub" [{:tool-uses [{:name "read_quarantined"
                       :input {:tool "web-demo" :input {:page "office-page.html"}
                               :question "What are the office hours on Tuesday 13 October?"
                               :schema {:type "object"
                                        :properties {:hours {:type "string"}}
                                        :required ["hours"]
                                        :additionalProperties false}}}]}
         {:tool-uses [{:name "fact_add"
                       :input {:text "The staging office is open 10:00 to 15:00 on Tuesday 13 October." :topic "office"}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Office hours"}} :outcome "Recorded the hours."}}]}
         {:text "Done."}]}

 :reader [{:text "{\"answer\": {\"hours\": \"10:00 to 15:00\"}}"}]

 :steps
 [{:run ["memo" "hub" "-s" "Office hours" "-m" "Check office-page.html: what are the hours on Tuesday 13 October?"]}
  {:tick 1}]

 :assert
 [[:has :tool-call {:role "hub" :name "read_quarantined" :verdict "allow"
                    :result [:all [:includes "10:00 to 15:00"] [:includes "\"free_text\":true"]]}]
  [:has :wake {:role "hub" :outcome "ran" :labels [:contains "contaminated"]}]
  [:has :fact {:text "The staging office is open 10:00 to 15:00 on Tuesday 13 October."
               :labels [:contains "contaminated"]}]
  [:has :memo {:subject "Office hours" :status :read :closed-by "hub"}]]}
