;; The public scout, granted reports of kind "grant" for this scenario
;; only, submits a report with report_submit. The next tick checks it with
;; staging's stand-in verifier, which reads the scenario fixture pages:
;; the first finding's quote is on its page, and the second's is not, so
;; that finding is flagged. The
;; operator reviews both at the terminal, accepts the first and marks the
;; second not relevant. Only the first reaches the ledger.
{:doc "A research report is checked, reviewed at the terminal, and its accepted finding enters the ledger."
 :live? false
 :clock "2026-10-12T09:00"
 :settings {:grants {"scout" {:reports {:kinds ["grant"]}}}}

 :model
 {"scout" [{:tool-uses [{:name "report_submit"
                         :input {:summary "Two arts grants open this spring."
                                 :findings [{:title "Harbour Arts Fund spring grant"
                                             :url "https://grants.example.org/arts-grant.html"
                                             :organization "Example Arts Council"
                                             :kind "grant"
                                             :deadline "2027-01-15"
                                             :amount {:value 5000 :currency "CAD"}
                                             :summary "Project grants for artists in Nova Scotia."
                                             :evidence [{:url "https://grants.example.org/arts-grant.html"
                                                         :quote "Grants of up to 5000 CAD for a project finished within a year."}]}
                                            {:title "Harbour Arts Fund travel grant"
                                             :url "https://grants.example.org/travel-grant.html"
                                             :organization "Example Arts Council"
                                             :kind "grant"
                                             :summary "Travel money for touring artists."
                                             :evidence [{:url "https://grants.example.org/travel-grant.html"
                                                         :quote "Travel grants of 2000 CAD for touring artists."}]}]}}]}
           {:tool-uses [{:name "memo_close"
                         :input {:memo {:memo-id {:subject "Find arts grants"}} :outcome "Reported two grants."}}]}
           {:text "Done."}]}

 :steps
 [{:run ["memo" "scout" "--public" "-s" "Find arts grants" "-m" "Find open arts grants for this spring."]}
  {:tick 1}
  {:assert [[:has :event {:type "report/submitted"}]
            [:has :report {:role "scout" :status :submitted}]
            [:has :memo {:subject "Find arts grants" :status :read :closed-by "scout"}]
            [:none :ledger {}]]}
  {:tick 1}
  {:assert [[:has :event {:type "report/verified"}]
            [:has :report {:role "scout" :status :verified
                           :verification {:findings [:all [:contains {:canonical-url "https://grants.example.org/arts-grant.html"
                                                                      :seen-before false
                                                                      :flags [:not [:contains {:kind "quote-not-found"}]]}]
                                                          [:contains {:canonical-url "https://grants.example.org/travel-grant.html"
                                                                      :seen-before false
                                                                      :flags [:contains {:kind "quote-not-found"}]}]]}}]
            [:has :notification {:kind "report-verified"}]]}
  {:run ["review" {:report-id {:role "scout"}}] :tty ["a" "n"]}]

 :assert
 [[:count :event {:type "finding/reviewed"} 2]
  [:has :event {:type "finding/reviewed" :data {:finding 0 :decision "accept"}}]
  [:has :event {:type "finding/reviewed" :data {:finding 1 :decision "not-relevant"}}]
  [:count :ledger {} 1]
  [:has :ledger {:role "scout" :kind "grant" :title "Harbour Arts Fund spring grant"
                 :deadline "2027-01-15" :status "new" :trusted true}]]}
