;; Eval case: the steward has a skill for the monthly reminder email. It reads
;; the skill before drafting and follows it: the project's name from the
;; facts, and the sign-off the skill gives. See relay.eval and relay.skills.
{:doc "The steward reads its skill before multi-step work and follows it."
 :live? true

 :eval {:id "skill-followed" :version 2 :tier :capability :tags [:skills] :trials 5}

 :clock "2026-10-12T09:00"

 :model
 {"steward" [{:tool-uses [{:name "doc_get" :input {:path "skills/steward/monthly-reminder.md"}}]}
         {:tool-uses [{:name "facts" :input {:topic "projects"}}]}
         {:tool-uses [{:name "tell_operator"
                       :input {:subject "Draft: monthly reminder"
                               :body "Hello team. The Lighthouse meeting is this month [[fact:6]]. Please bring your notes.\n\nWarm regards, the Lighthouse team"}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Monthly reminder"}} :outcome "Drafted the reminder from the skill."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "Followed skills/steward/monthly-reminder.md for the monthly reminder draft. It worked as written."}}]}
         {:text "Done."}]}

 :foils
 {"ignores-the-skill"
  {:fails #{:read-the-skill :uses-its-sign-off :skill-read-first}
   :model {"steward" [{:tool-uses [{:name "tell_operator"
                                :input {:subject "Draft: monthly reminder"
                                        :body "Hi everyone, reminder about this month's meeting. Best, Steward"}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Monthly reminder"}} :outcome "Drafted."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Drafted."}}]}]}}}

 :steps
 [{:run ["put" "skills/steward/monthly-reminder.md"]
   :stdin "# Monthly reminder email\n\nUse when: the operator asks for the monthly reminder email.\n\n1. Look up the project name in the facts under topic projects.\n2. Write three sentences or fewer and cite the facts you used.\n3. End with the sign-off: Warm regards, the Lighthouse team\n"}
  {:run ["memo" "steward" "-s" "Monthly reminder" "-m" "Please draft the monthly reminder email to the team."]}
  {:tick 1}]

 :assert
 [[:has :wake {:role "steward" :outcome "ran"}]
  [:has :doc {:path "skills/steward/monthly-reminder.md"}]]

 :graders
 [{:id :read-the-skill
   :doc "The steward read its skill with doc_get."
   :check [:has :tool-call {:role "steward" :name "doc_get" :input {:path "skills/steward/monthly-reminder.md"} :verdict "allow"}]}
  {:id :skill-read-first
   :doc "It read the skill before it gave anyone the draft or saved it."
   :check [:before :tool-call {:name "doc_get" :input {:path "skills/steward/monthly-reminder.md"}}
           {:name [:any "tell_operator" "memo_send" "doc_put"]}]}
  {:id :uses-its-sign-off
   :doc "The draft, in the message or in a doc outside skills/, ends the way the skill says."
   :check [:or [:has :message {:origin [:any "told" "memo-for-operator"] :text [:regex "Warm regards,\\s*the Lighthouse team"]}]
           [:has :doc {:path [:not [:regex "^skills/"]] :content [:regex "Warm regards,\\s*the Lighthouse team"]}]]}]}
