;; Eval case: the hub records a temporary closure as a fact with both ends,
;; under the office topic that already exists, and does not bother the
;; operator about it. See relay.eval.
{:doc "The hub records a temporary closure as a fact with both ends."
 :live? true

 :eval {:id "fact-validity-window" :version 1 :tier :regression :tags [:knowledge :facts] :trials 5}

 ;; A Monday, Halifax time.
 :clock "2026-10-12T09:00"

 :model
 {"hub" [{:tool-uses [{:name "facts" :input {:topic "office"}}]}
         {:tool-uses [{:name "fact_add"
                       :input {:text "The staging office is closed for renovations from 3 November to 14 November 2026."
                               :topic "office"
                               :valid_from "2026-11-03"
                               :valid_to "2026-11-15"}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Office renovations"}}
                               :outcome "Recorded the renovation closure as an office fact, 3 to 14 November."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "Operator said the office is closed for renovations 3-14 Nov. Recorded it as a fact under office, valid to the 15th. Nothing open."}}]}
         {:text "Done."}]}

 :foils
 {"no-end-date"
  {:fails #{:valid-to}
   :model {"hub" [{:tool-uses [{:name "fact_add"
                                :input {:text "The staging office is closed for renovations from 3 November."
                                        :topic "office" :valid_from "2026-11-03"}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Office renovations"}} :outcome "Recorded it."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Recorded the renovation."}}]}]}}
  "own-topic"
  {:fails #{:topic}
   :model {"hub" [{:tool-uses [{:name "fact_add"
                                :input {:text "The staging office is closed for renovations from 3 to 14 November 2026."
                                        :topic "renovations" :valid_from "2026-11-03" :valid_to "2026-11-14"}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Office renovations"}} :outcome "Recorded it."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Recorded the renovation."}}]}]}}}

 :steps
 [{:run ["memo" "hub" "-s" "Office renovations"
         "-m" "FYI the office is closed for renovations from November 3 to November 14."]}
  {:tick 2}]

 :assert
 [[:has :wake {:role "hub" :outcome "ran"}]]

 :graders
 [{:id :recorded
   :doc "Exactly one current fact about the renovation."
   :check [:count :fact {:current true :text [:regex "(?i)renovat"]} 1]}
  {:id :valid-from
   :check [:has :fact {:current true :text [:regex "(?i)renovat"] :valid-from [:on-date "2026-11-03"]}]}
  {:id :valid-to
   :doc "Either reading of an inclusive end passes."
   :check [:has :fact {:current true :text [:regex "(?i)renovat"] :valid-to [:on-date "2026-11-14" "2026-11-15"]}]}
  {:id :topic
   :doc "Under the office topic the seed already has."
   :check [:has :fact {:current true :text [:regex "(?i)renovat"] :topic [:regex "^office(/|$)"]}]}
  {:id :quiet
   :check [:none :memo {:to "operator"}]}
  {:id :closed
   :check [:has :memo {:subject "Office renovations" :closed-by "hub"}]}
  ;; Skipped until judges are built; never gating.
  {:id :fact-stands-alone
   :judge {:rubric :fact-stands-alone
           :evidence [[:facts {:current true :text [:regex "(?i)renovat"]}]]}}]}
