;; Eval case: something to remember, with nothing to decide, is recorded
;; without paging the operator. See relay.eval.
{:doc "A thing to remember is recorded without a message or notification to the operator."
 :live? true

 :eval {:id "no-needless-notify" :version 2 :tier :regression :tags [:attention :facts :messages] :trials 5}

 :clock "2026-10-12T09:00"

 :model
 {"steward" [{:tool-uses [{:name "fact_add"
                       :input {:text "The operator's sister Ana's birthday is March 3."
                               :topic "family"}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Ana's birthday"}}
                               :outcome "Recorded Ana's birthday, March 3, as a fact."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "Recorded that the operator's sister Ana's birthday is March 3. Nothing open."}}]}
         {:text "Done."}]}

 :foils
 {"noted"
  {:fails #{:no-message :nothing-sent}
   :model {"steward" [{:tool-uses [{:name "fact_add"
                                :input {:text "The operator's sister Ana's birthday is March 3." :topic "family"}}
                               {:name "tell_operator"
                                :input {:subject "Noted!" :body "I recorded Ana's birthday."}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Ana's birthday"}} :outcome "Recorded it."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Recorded Ana's birthday."}}]}]}}}

 :steps
 [{:run ["memo" "steward" "-s" "Ana's birthday" "-m" "My sister Ana's birthday is March 3."]}
  {:tick 2}]

 :assert
 [[:has :wake {:role "steward" :outcome "ran"}]]

 :graders
 [{:id :recorded
   :check [:has :fact {:current true :text [:all [:includes "Ana"] [:regex "(?i)march 3|3 march|march 3rd|-03-03"]]}]}
  {:id :no-message
   :doc "No role tells the operator anything: there is nothing to decide."
   :check [:none :message {:origin [:any "told" "memo-for-operator"]}]}
  {:id :nothing-sent
   :doc "No notification went out but relay's own quiet answer to the request, which says what came of it."
   :check [:none :sent {:title [:not "Re: Ana's birthday"]}]}
  {:id :closed
   :check [:has :memo {:subject "Ana's birthday" :closed-by "steward"}]}]}
