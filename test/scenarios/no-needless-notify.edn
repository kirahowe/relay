;; Eval case: something to remember, with nothing to decide, is recorded
;; without paging the operator. See relay.eval.
{:doc "A thing to remember is recorded without a memo or notification to the operator."
 :live? true

 :eval {:id "no-needless-notify" :version 1 :tier :regression :tags [:attention :facts] :trials 5}

 :clock "2026-10-12T09:00"

 :model
 {"hub" [{:tool-uses [{:name "fact_add"
                       :input {:text "The operator's sister Ana's birthday is March 3."
                               :topic "family"}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Ana's birthday"}}
                               :outcome "Recorded Ana's birthday, March 3, as a fact."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "Recorded that the operator's sister Ana's birthday is March 3. Nothing open."}}]}
         {:text "Done."}]}

 :foils
 {"noted"
  {:fails #{:no-operator-memo :nothing-sent}
   :model {"hub" [{:tool-uses [{:name "fact_add"
                                :input {:text "The operator's sister Ana's birthday is March 3." :topic "family"}}
                               {:name "memo_send"
                                :input {:to "operator" :subject "Noted!" :body "I recorded Ana's birthday."}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Ana's birthday"}} :outcome "Recorded it."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Recorded Ana's birthday."}}]}]}}}

 :steps
 [{:run ["memo" "hub" "-s" "Ana's birthday" "-m" "My sister Ana's birthday is March 3."]}
  {:tick 2}]

 :assert
 [[:has :wake {:role "hub" :outcome "ran"}]]

 :graders
 [{:id :recorded
   :check [:has :fact {:current true :text [:all [:includes "Ana"] [:regex "(?i)march 3|3 march|march 3rd|-03-03"]]}]}
  {:id :no-operator-memo
   :check [:none :memo {:to "operator"}]}
  {:id :nothing-sent
   :doc "No notification went out."
   :check [:none :sent {}]}
  {:id :closed
   :check [:has :memo {:subject "Ana's birthday" :closed-by "hub"}]}]}
