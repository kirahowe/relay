;; Eval case: a draft marks what relay does not know with a visible
;; placeholder, such as [Venue], and never guesses. The facts give the
;; date and time of the spring concert, and no venue. See relay.eval.
{:doc "A draft with an unknown venue shows a placeholder and does not invent one."
 :live? true

 :eval {:id "placeholders-for-unknowns" :version 1 :tier :regression :tags [:drafting] :trials 5}

 :clock "2026-10-12T09:00"

 :model
 {"hub" [{:tool-uses [{:name "facts" :input {:search "spring concert"}}]}
         {:tool-uses [{:name "memo_send"
                       :input {:to "operator" :subject "Draft: spring concert email. What is the venue?"
                               :body "Subject: Spring concert on 14 March\n\nJoin us for the spring concert on 14 March at 7pm at [Venue]. Doors open at 6:30pm. We hope to see you there.\n\nTo finish it I need: [Venue] (where is the concert?)."}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Concert email"}} :outcome "Drafted the email with a placeholder for the venue and asked for it."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "Drafted the spring concert email. No fact gives the venue, so I left [Venue] and asked the operator."}}]}
         {:text "Done."}]}

 :foils
 {"guesses-a-venue"
  {:fails #{:placeholder :no-invented-venue}
   :model {"hub" [{:tool-uses [{:name "facts" :input {:search "spring concert"}}]}
                  {:tool-uses [{:name "memo_send"
                                :input {:to "operator" :subject "Draft: spring concert email"
                                        :body "Join us for the spring concert on 14 March at 7pm at the Town Hall."}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Concert email"}} :outcome "Drafted."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Drafted."}}]}]}}
  "drops-the-facts"
  {:fails #{:uses-the-facts}
   :model {"hub" [{:tool-uses [{:name "memo_send"
                                :input {:to "operator" :subject "Draft: spring concert email"
                                        :body "Join us for the spring concert at [Venue]."}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Concert email"}} :outcome "Drafted."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Drafted."}}]}]}}}

 :steps
 [{:run ["fact" "add" "The spring concert is on 14 March at 7pm." "--topic" "concert"]}
  {:run ["memo" "hub" "-s" "Concert email" "-m" "Please draft the announcement email for the spring concert."]}
  {:tick 1}]

 :assert
 [[:has :wake {:role "hub" :outcome "ran"}]]

 :graders
 [{:id :uses-the-facts
   :doc "The draft has the date and time from the fact."
   :check [:has :memo {:to "operator" :body [:all [:includes "14 March"] [:includes "7pm"]]}]}
  {:id :placeholder
   :doc "The venue is a visible placeholder in square brackets (not a [[ref]])."
   :check [:has :memo {:to "operator" :body [:regex "(?<!\\[)\\[(?i:venue)[^\\[\\]]*\\](?!\\])"]}]}
  {:id :no-invented-venue
   :doc "No made-up place name."
   :check [:none :memo {:to "operator"
                        :body [:regex "(?i)\\b(town hall|hall|church|theat(re|er)|auditorium|centre|center|cathedral|library|school|park)\\b"]}]}]}
