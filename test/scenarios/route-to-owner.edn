;; Eval case: the hub passes a reminder to the clerk, which owns reminders
;; and holds remind-demo, and the clerk sets it. No new role. See
;; relay.eval.
{:doc "The hub hands work to the role that owns it, and that role does it."
 :live? true

 :eval {:id "route-to-owner" :version 1 :tier :regression :tags [:routing :memos] :trials 5}

 ;; A Monday, so tomorrow is Tuesday 13 October.
 :clock "2026-10-12T09:00"

 :model
 {"hub" [{:tool-uses [{:name "roles" :input {}}]}
         {:tool-uses [{:name "memo_send"
                       :input {:to "clerk" :subject "Reminder: call the bank, Tue 13 Oct 09:00"
                               :body "Set a reminder for the operator to call the bank on Tuesday 13 October 2026 at 09:00. Close this memo once it is set."}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Bank call"}}
                               :outcome "Handed to the clerk to set a reminder for Tue 13 Oct at 09:00."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "Operator wants a reminder to call the bank tomorrow at 9. The clerk owns reminders, so I passed it on. Nothing open."}}]}
         {:text "Done."}]
  "clerk" [{:tool-uses [{:name "remind-demo" :input {:args ["Call the bank" "2026-10-13 09:00"]}}]}
           {:tool-uses [{:name "memo_close"
                         :input {:memo {:memo-id {:from "hub" :to "clerk"}}
                                 :outcome "Set a reminder to call the bank on 13 October at 09:00."}}]}
           {:tool-uses [{:name "journal_write"
                         :input {:text "The hub asked for a reminder to call the bank, Tue 13 Oct 09:00. Set it with remind-demo. Nothing open."}}]}
           {:text "Done."}]}

 :foils
 {"says-done"
  {:fails #{:handed-on :reminder-set :reminder-dated :clerk-closed}
   :model {"hub" [{:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Bank call"}} :outcome "Reminder set."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Set the bank reminder."}}]}]}}}

 :steps
 [{:run ["memo" "hub" "-s" "Bank call" "-m" "Remind me to call the bank tomorrow at 9."]}
  {:tick 3}]

 :assert
 [[:has :wake {:role "hub" :outcome "ran"}]]

 :graders
 [{:id :handed-on
   :check [:has :memo {:from "hub" :to "clerk" :body [:regex "(?i)bank"]}]}
  {:id :hub-closed
   :check [:has :memo {:subject "Bank call" :closed-by "hub"}]}
  {:id :reminder-set
   :doc "The clerk called remind-demo about the bank at 9."
   :check [:has :tool-call {:role "clerk" :name "remind-demo"
                            :input {:args [:all [:contains [:regex "(?i)bank"]]
                                           [:contains [:regex "(?i)\\b0?9(:00)?\\b|\\b9 ?a\\.?m"]]]}}]}
  {:id :reminder-dated
   :doc "The reminder says when: tomorrow, Tuesday or the 13th. Reported, not gating."
   :gating? false
   :check [:has :tool-call {:role "clerk" :name "remind-demo"
                            :input {:args [:contains [:regex "(?i)tomorrow|tue|\\b13\\b|-13"]]}}]}
  {:id :clerk-closed
   :check [:has :memo {:from "hub" :to "clerk" :closed-by "clerk"}]}
  {:id :no-new-role
   :check [:and [:none :tool-call {:name "role_add"}] [:count :role {} 3]]}
  ;; Skipped until judges are built; never gating.
  {:id :hand-on-complete
   :judge {:rubric :memo-self-contained :evidence [[:memos {:from "hub" :to "clerk"}]]}}]}
