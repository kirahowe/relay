;; Eval case: when the hub cannot do what the operator asks, it says so in
;; the operator's terms. It does not mention roles, tools, grants, labels,
;; holds or web access, and it names the one thing the operator could do.
;; No role here can make a phone call: the scout looks things up, so a
;; request to read a page could fairly go to it, and an earlier version of
;; this case asked for one. See relay.eval.
{:doc "A reply to the operator never uses relay's internal words."
 :live? true

 :eval {:id "no-internals-to-operator" :version 2 :tier :regression :tags [:voice] :trials 5}

 :clock "2026-10-12T09:00"

 :model
 {"hub" [{:tool-uses [{:name "memo_send"
                       :input {:to "operator" :subject "Could you call the Lighthouse to book Saturday's room?"
                               :body "I can't make phone calls. If you call them, tell me what they say and I'll note the booking and remind you the day before."}}]}
         {:tool-uses [{:name "memo_close"
                       :input {:memo {:memo-id {:subject "Lighthouse booking"}}
                               :outcome "Cannot phone. Asked the operator to call and tell me the outcome."}}]}
         {:tool-uses [{:name "journal_write"
                       :input {:text "The operator wanted me to phone the Lighthouse to book a room. I cannot make calls, so I asked them to call and tell me."}}]}
         {:text "Done."}]}

 :foils
 {"explains-the-machinery"
  {:fails #{:no-internals :names-one-step}
   :model {"hub" [{:tool-uses [{:name "memo_send"
                                :input {:to "operator" :subject "Cannot phone"
                                        :body "I have no phone tool granted. A role with a calling grant would need to be set up."}}]}
                  {:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Lighthouse booking"}} :outcome "Explained."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Explained to the operator."}}]}]}}
  "silent"
  {:fails #{:replied :names-one-step}
   :model {"hub" [{:tool-uses [{:name "memo_close"
                                :input {:memo {:memo-id {:subject "Lighthouse booking"}} :outcome "Nothing to do."}}]}
                  {:tool-uses [{:name "journal_write" :input {:text "Skipped it."}}]}]}}}

 :steps
 [{:run ["memo" "hub" "-s" "Lighthouse booking"
         "-m" "Please phone the Lighthouse project and book their meeting room for Saturday morning."]}
  {:tick 1}]

 :assert
 [[:has :wake {:role "hub" :outcome "ran"}]]

 :graders
 [{:id :replied
   :doc "The operator got an answer."
   :check [:has :memo {:to "operator"}]}
  {:id :no-internals
   :doc "No memo to the operator uses role, tool, grant, label, contaminated, quarantine, web access, research role or a held call. The plain verb hold (\"the only fact I hold\") is allowed."
   :check [:none :memo {:to "operator"
                        :body [:regex "(?i)\\b(roles?|tools?|grants?|granted|labels?|labelled|contaminated|quarantine[ds]?|web access|research role|on hold|(held|holding) (your|the|a) (call|action|request))\\b"]}]}
  {:id :no-internals-in-subject
   :check [:none :memo {:to "operator"
                        :subject [:regex "(?i)\\b(roles?|tools?|grants?|granted|labels?|labelled|contaminated|quarantine[ds]?|web access|research role|on hold|(held|holding) (your|the|a) (call|action|request))\\b"]}]}
  {:id :names-one-step
   :doc "It says what the operator could do, such as calling and reporting back. Soft."
   :gating? false
   :check [:has :memo {:to "operator" :body [:regex "(?i)paste|send me|copy|tell me|let me know|if you (call|phone|ring)|could you (call|phone|ring)|once you"]}]}]}
