#!/usr/bin/env bb
;; A stand-in for webtool check, so no test reaches the network. It reads
;; the call on stdin and answers each item from its URL alone:
;;
;;   .../missing...   the page is fetched, and no quote is found on it
;;   .../refused...   the guard refuses it: "refused: 10.0.0.1 is a private address"
;;   .../gone...      the fetch fails: "connection reset"
;;   .../moved...     it redirects to another domain, other.example.net
;;   .../styled...    the page cannot be checked: "an element can paint over others"
;;   xn--...          the host is punycode with mixed scripts
;;   anything else    fetched, complete, every quote found
;;
;; Modes: ok (the above), garbled (prints something that is not an
;; envelope), short (answers with one item too few), exit (exits 3),
;; huge (prints more than relay reads).
(require '[cheshire.core :as json]
         '[clojure.string :as str])

(defn- host [url] (second (re-find #"(?i)https?://([^/?#:]+)" url)))

(defn- domain [h]
  (let [labels (str/split (str h) #"\.")] (str/join "." (take-last 2 labels))))

(defn- host-info [h]
  (let [puny (str/starts-with? (str h) "xn--")]
    {:name h :punycode puny :unicode (if puny (str "аpple" (subs h (count "xn--pple-43d"))) h)
     :scripts (if puny ["Cyrillic" "Latin"] ["Latin"]) :mixed_scripts puny}))

(defn- answer [{:strs [url quotes]}]
  (let [h (host url)
        has #(str/includes? url %)
        failed (cond (has "refused") "refused: 10.0.0.1 is a private address"
                     (has "gone") "connection reset"
                     :else "")
        final (if (has "moved") "https://other.example.net/landing" url)
        fetched (str/blank? failed)
        uncheckable (if (has "styled") "an element can paint over others" "")
        found (and fetched (str/blank? uncheckable) (not (has "missing")))]
    {:url url :fetched fetched :complete fetched :uncheckable uncheckable :error failed
     :status (if fetched 200 0) :final_url (if fetched final "")
     :redirects (if (has "moved") [{:url url :status 301}] [])
     :crosses_domains (has "moved") :domain (domain h) :final_domain (if fetched (domain (host final)) "")
     :host (host-info h) :final_host (when fetched (host-info (host final)))
     :sha256 (if fetched (apply str (repeat 64 "a")) "") :hidden_chars 0
     :quotes (mapv (fn [q] {:quote q :found found :hidden_chars false}) quotes)}))

(let [mode (first *command-line-args*)
      call (json/parse-string (slurp *in*))
      items (get-in call ["input" "items"])
      reply (fn [content] (println (json/generate-string {:content (json/generate-string content)
                                                          :is_error false :labels ["contaminated"]})))]
  (case mode
    "ok" (reply {:items (mapv answer items)})
    "short" (reply {:items (mapv answer (rest items))})
    "garbled" (println "not an envelope")
    "exit" (System/exit 3)
    "huge" (let [chunk (apply str (repeat 65536 "x"))] (dotimes [_ 200] (print chunk)) (flush))))
