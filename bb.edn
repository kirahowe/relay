{:paths ["src" "resources"]
 :deps {org.clojure/test.check {:mvn/version "1.1.1"}}
 :tasks
 {tck {:doc "Run the ACP conformance kit against relay acp (needs Go, uv and ../agentloop)."
       :task (shell "scripts/tck.sh")}
  test {:doc "Run the tests. Pass namespace names to run only those."
        :extra-paths ["test"]
        :requires ([relay.test-runner :as runner])
        :task (runner/run! *command-line-args*)}
  soak {:doc "Run the model-based property many more times: bb soak [trials]"
        :extra-paths ["test"]
        :requires ([relay.core-test :as core-test])
        :task (let [n (or (some-> (first *command-line-args*) parse-long) 20000)
                    result (core-test/the-rules-hold-under-any-sequence-of-commands n)]
                (prn (select-keys result [:pass? :num-tests :seed :shrunk]))
                (when-not (:pass? result) (System/exit 1)))}}}
