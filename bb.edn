{:paths ["src" "resources"]
 :deps {org.clojure/test.check {:mvn/version "1.1.1"}}
 :tasks
 {tck {:doc "Run the ACP conformance kit against relay acp (needs Go, uv and ../agentloop)."
       :task (shell "scripts/tck.sh")}
  test {:doc "Run the tests. Pass namespace names to run only those."
        :extra-paths ["test"]
        :requires ([relay.test-runner :as runner])
        :task (runner/run! *command-line-args*)}
  pentest {:doc "Attack relay, agentloop, acp-tui and cleanroom together on artificial data: bb pentest --help"
           :extra-paths ["test" "pentest"]
           :requires ([relay.pentest.main :as pentest])
           :task (pentest/run! *command-line-args*)}
  staging {:doc "Make a data directory of artificial data: bb staging init [<dir>] [--force]"
           :requires ([relay.staging :as staging])
           :task (apply staging/-main *command-line-args*)}
  scenario {:doc "Run one scenario: bb scenario <name> [--live] [--data <dir>] [--force]"
            :extra-paths ["test"]
            :requires ([relay.scenario-runner :as runner])
            :task (apply runner/scenario-main *command-line-args*)}
  scenarios {:doc "Run every scenario against the mock model."
             :extra-paths ["test"]
             :requires ([relay.scenario-runner :as runner])
             :task (runner/scenarios-main)}
  soak {:doc "Run the model-based property many more times: bb soak [trials]"
        :extra-paths ["test"]
        :requires ([relay.core-test :as core-test]
                   [relay.test-support :as support])
        :task (let [_ (support/isolate!)
                    n (or (some-> (first *command-line-args*) parse-long) 20000)
                    result (core-test/the-rules-hold-under-any-sequence-of-commands n)]
                (prn (select-keys result [:pass? :num-tests :seed :shrunk]))
                (when-not (:pass? result) (System/exit 1)))}}}
