#!/usr/bin/env bb
;; The relay command. Run `relay help` for usage.

(require '[babashka.classpath :as cp]
         '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.java.io :as io])

(let [script (fs/real-path *file*)
      root (fs/parent (fs/parent script))
      config (str (fs/path root "bb.edn"))
      cli (str (fs/path root "src" "relay" "cli.clj"))
      found #(some-> (io/resource "relay/cli.clj") io/file fs/real-path str)]
  ;; The path relay was run by, not the file it leads to: a Homebrew
  ;; install runs /opt/homebrew/bin/relay, a link into a keg whose path
  ;; changes with every upgrade, and relay writes this path into settings
  ;; (relay connect's token command) and into every wake's tool command.
  (System/setProperty "relay.bin" (str (fs/absolutize *file*)))
  (cp/add-classpath (str (fs/path root "src") ":" (fs/path root "resources")))
  ;; bb puts the :paths of the bb.edn in the current directory ahead of
  ;; what this adds, so inside another checkout relay would run that
  ;; checkout's code. Run again under this checkout's own bb.edn then.
  (when (not= cli (found))
    (when (= config (System/getProperty "babashka.config"))
      (binding [*out* *err*]
        (println (str "relay cannot load its own code from " root "."))
        (System/exit 1)))
    (apply p/exec "bb" "--config" config (str (fs/absolutize *file*)) *command-line-args*)))

(require '[relay.cli :as cli])

(apply cli/-main *command-line-args*)
