<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the dispatcher once a minute. Replace @BB@, @RELAY@, @DATA@,
     @HOME@ and @LOGS@ with absolute paths; see the README. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>relay.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BB@</string>
    <string>@RELAY@/bin/relay</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>RELAY_DATA</key>
    <string>@DATA@</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <!-- A tick starts wakes and exits; without this launchd would kill them. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@LOGS@/tick.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/tick.log</string>
</dict>
</plist>
