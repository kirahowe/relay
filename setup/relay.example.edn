;; relay's settings. Copy this to <data dir>/relay.edn and edit it. Only the
;; operator edits this file; no role has a tool that can read it.
;; :timezone, :default-harness, :harnesses and :notify are required.
{:timezone "America/New_York"

 :default-harness :agentloop
 :harnesses
 {:agentloop {:kind :agentloop
              :model "claude-opus-5-5"
              :effort "medium"          ; low, medium, high, xhigh or max
              ;; :bin "/path/to/agentloop"   ; default: PATH, then ../agentloop/bin
              ;; :retry {:retries 2 :backoff-seconds 2 :max-wait-seconds 30}
              ;; Stops one hung tool call from eating the whole wake.
              ;; :tool-timeout-seconds 300
              ;; The Anthropic API key, from the login keychain. Store it with
              ;;   security add-generic-password -a "$USER" -s relay-anthropic -w
              :api-key-command ["security" "find-generic-password" "-s" "relay-anthropic" "-w"]}}

 ;; Where notifications go. See setup/ntfy/server.yml for the server.
 ;; With the server locked down, give relay its write token from the login
 ;; keychain (setup/ntfy/lockdown stores it there):
 ;;   :token-command ["security" "find-generic-password" "-s" "relay-ntfy" "-w"]
 ;; or from a file only you can read, with :token-file "/path/to/token".
 :notify {:kind :ntfy :url "http://127.0.0.1:2586" :topic "relay"}
 ;; Other kinds: {:kind :macos}, {:kind :command :command [...]},
 ;; {:kind :none}, and {:kind :file :path "/path/to/notifications.log"},
 ;; which appends one JSON line per notification and reaches nobody (used
 ;; by staging data).

 ;; The role that is sent dead letters to sort out.
 :dead-letter-handler "hub"

 ;; A weekly budget in US dollars for all roles together. relay notifies
 ;; you when the week's spend (from Monday) reaches 80% of it and 100%.
 ;; It never stops anything. Leave it out for no budget.
 ;; :budget {:weekly-usd 15}

 ;; A morning brief at 07:30 in :timezone: today's calendar, reminders due,
 ;; reports waiting and held calls, in one notification. relay composes it
 ;; itself, with the "cal" and "rem-read" tools defined below; :calendar and
 ;; :reminders name other :read tools. Nothing is sent on a day with
 ;; nothing to say. Leave it out for no brief.
 ;; :brief {:at "07:30"}

 ;; Tools beyond relay's own, each an external command given the call's
 ;; arguments after its own, with no -- in between: such a tool must
 ;; refuse flags in the model's part, as rem does. New tools
 ;; are better written for the envelope protocol (see below). Every tool has a :class, which says what a
 ;; call can do:
 ;;   :read    returns content and sends nothing out
 ;;   :write   changes relay's own data only
 ;;   :egress  can send what the model chooses where an outsider can see it
 ;;   :act     does something in your name outside relay
 ;; and :labels, the labels its output always carries, as strings:
 ;; "contaminated" when an outsider could have written any of it (a web
 ;; page, an email, someone else's repository), "private" when it is your
 ;; private data. [] means neither. A session that has seen both private
 ;; and contaminated text needs your approval for an :egress call, and
 ;; one that has seen anything contaminated needs it for an :act call
 ;; (relay holds, relay approve). :always-hold true asks every time.
 :tools
 ;; Reminders is two tools over one binary. The operator fixes --mode here;
 ;; the model's arguments come after it and cannot change it. Reading is
 ;; labelled private only, which trusts every list's text. If any list is
 ;; shared with other people, add "contaminated": their text could carry
 ;; instructions, and writing can send text to them. See
 ;; tools/rem/README.md.
 {"rem-read" {:class :read
              :labels ["private"]
              :description "Read Apple Reminders. Run with [\"help\"] for the commands."
              :command ["/path/to/relay/tools/rem/rem" "--mode" "read"]}
  "rem" {:class :act
         :labels ["private"]
         :description "Change Apple Reminders. Run with [\"help\"] for the commands."
         :command ["/path/to/relay/tools/rem/rem" "--mode" "write"]}}

 ;; Calendar is one read-only tool; cal cannot create, change or delete
 ;; anything and takes no operator-pinned option, so the command is just the
 ;; binary. Invites and shared calendars carry text other people wrote, so its
 ;; output is both private and contaminated. Grant it with :tools ["cal"].
 ;; See tools/cal/README.md.
 ;; "cal" {:class :read
 ;;        :labels ["private" "contaminated"]
 ;;        :description "Read Apple Calendar. Run with [\"help\"] for the commands."
 ;;        :command ["/path/to/relay/tools/cal/cal"]}

 ;; A tool can speak relay's envelope protocol instead of taking arguments
 ;; on its command line: it gets the call as JSON on stdin, with the
 ;; session's labels, and answers with {content, is_error, labels}, its
 ;; reported labels added to :labels. :parameters is the JSON Schema for
 ;; its input, checked by relay; without it the tool checks its own input.
 ;; cleanroom answers questions about your mail this way (see its USAGE.md):
 ;; Every answer comes from your mail, so it is private whatever cleanroom
 ;; reports.
 ;; "mail" {:class :read
 ;;         :labels ["private"]
 ;;         :protocol :envelope
 ;;         :timeout-seconds 200
 ;;         :description "Ask a question about your mail; run cleanroom relay-tool --schema for this text."
 ;;         :parameters {:type "object" ...}   ; from cleanroom relay-tool --schema
 ;;         :command ["/path/to/bin/cleanroom" "relay-tool" "--policy" "/path/to/policy.jsonc"]}

 ;; Tools for a public role that searches the web. No web tool comes with
 ;; relay yet; these show the shape. Their output is contaminated, never
 ;; private.
 ;; "web-search" {:class :egress
 ;;               :labels ["contaminated"]
 ;;               :protocol :envelope
 ;;               :description "Search the web."
 ;;               :command ["/path/to/web-search"]}
 ;; "web-fetch" {:class :egress
 ;;              :labels ["contaminated"]
 ;;              :protocol :envelope
 ;;              :description "Fetch a page."
 ;;              :command ["/path/to/web-fetch"]}

 ;; How relay checks a research role's reports: webtool's check, run on
 ;; the envelope protocol (see webtool's README). relay runs it itself, in
 ;; a process of its own for each report; no role is granted it. Each call
 ;; fetches up to twenty pages, so give it time. Needed once any role is
 ;; granted :reports.
 ;; :verifier {:command ["/path/to/webtool/bin/webtool" "--config" "/path/to/webtool.json" "check"]
 ;;            :timeout-seconds 600}

 ;; What each role is granted beyond relay's own tools: :tools, :may-add,
 ;; :public and :reports, and nothing else. A public role never holds your
 ;; private data, so it may search and browse without asking you. It is
 ;; shown only what is public (written with --public, by a public role, or
 ;; declassified), and it may not have :may-add, a tool whose :labels
 ;; include "private", or the dead letter handler's job. :reports lets a
 ;; public role write research reports of the kinds named, which relay
 ;; checks and you review with relay review.
 :grants
 {"hub" {:may-add true :tools ["rem-read" "rem"]}
  ;; Add it with relay add grant-search --public, so its own text is public.
  ;; "grant-search" {:public true :tools ["web-search" "web-fetch"]
  ;;                 :reports {:kinds ["grant"]}}
  }}
