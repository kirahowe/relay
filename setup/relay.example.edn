;; relay's settings. Copy this to <data dir>/relay.edn and edit it. Only the
;; operator edits this file; no role has a tool that can read it.
;; :timezone, :default-harness, :harnesses and :notify are required.
{:timezone "America/New_York"

 :default-harness :agentloop
 :harnesses
 {:agentloop {:kind :agentloop
              :model "claude-opus-5-5"
              :effort "medium"          ; low, medium, high, xhigh or max
              ;; :bin "/path/to/agentloop"   ; default: PATH, then ../agentloop/bin
              ;; :retry {:retries 2 :backoff-seconds 2 :max-wait-seconds 30}
              ;; Stops one hung tool call from eating the whole wake.
              ;; :tool-timeout-seconds 300
              ;; The Anthropic API key, from the login keychain. Store it with
              ;;   security add-generic-password -a "$USER" -s relay-anthropic -w
              :api-key-command ["security" "find-generic-password" "-s" "relay-anthropic" "-w"]}}

 ;; Where notifications go. See setup/ntfy/server.yml for the server.
 ;; With the server locked down, give relay its write token from a file or
 ;; a command: :token-file "/path/to/token" or :token-command [...].
 :notify {:kind :ntfy :url "http://127.0.0.1:2586" :topic "relay"}

 ;; The role that is sent dead letters to sort out.
 :dead-letter-handler "hub"

 ;; Tools beyond relay's own, each an external command given the call's
 ;; arguments after its own, with no -- in between: such a tool must
 ;; refuse flags in the model's part, as rem and github-file do. New tools
 ;; are better written for the envelope protocol (see below). Every tool has a :class, which says what a
 ;; call can do:
 ;;   :read    returns content and sends nothing out
 ;;   :write   changes relay's own data only
 ;;   :egress  can send what the model chooses where an outsider can see it
 ;;   :act     does something in your name outside relay
 ;; and :labels, the labels its output always carries, as strings:
 ;; "contaminated" when an outsider could have written any of it (a web
 ;; page, an email, someone else's repository), "private" when it is your
 ;; private data. [] means neither. A session that has seen both private
 ;; and contaminated text needs your approval for an :egress call, and
 ;; one that has seen anything contaminated needs it for an :act call
 ;; (relay holds, relay approve). :always-hold true asks every time.
 :tools
 ;; Reminders is two tools over one binary. The operator fixes --mode here;
 ;; the model's arguments come after it and cannot change it. Reading brings
 ;; in text other people may have written (shared lists); writing can send
 ;; text to them. See tools/rem/README.md.
 {"rem-read" {:class :read
              :labels ["private" "contaminated"]
              :description "Read Apple Reminders. Run with [\"help\"] for the commands."
              :command ["/path/to/relay/tools/rem/rem" "--mode" "read"]}
  "rem" {:class :act
         :labels ["private"]
         :description "Change Apple Reminders. Run with [\"help\"] for the commands."
         :command ["/path/to/relay/tools/rem/rem" "--mode" "write"]}}

 ;; A tool can speak relay's envelope protocol instead of taking arguments
 ;; on its command line: it gets the call as JSON on stdin, with the
 ;; session's labels, and answers with {content, is_error, labels}, its
 ;; reported labels added to :labels. :parameters is the JSON Schema for
 ;; its input, checked by relay; without it the tool checks its own input.
 ;; cleanroom answers questions about your mail this way (see its USAGE.md):
 ;; Every answer comes from your mail, so it is private whatever cleanroom
 ;; reports.
 ;; "mail" {:class :read
 ;;         :labels ["private"]
 ;;         :protocol :envelope
 ;;         :timeout-seconds 200
 ;;         :description "Ask a question about your mail; run cleanroom relay-tool --schema for this text."
 ;;         :parameters {:type "object" ...}   ; from cleanroom relay-tool --schema
 ;;         :command ["/path/to/bin/cleanroom" "relay-tool" "--policy" "/path/to/policy.jsonc"]}

 ;; What each role is granted beyond relay's own tools.
 :grants
 {"hub" {:may-add true :tools ["rem-read" "rem"]}}}
